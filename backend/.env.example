# Copy missing values to backend/.env; preserve any existing API keys there.
SAMVED_DB_URL=jdbc:mysql://127.0.0.1:3306/samved
SAMVED_DB_USER=samved
SAMVED_DB_PASSWORD=replace-with-your-local-database-password
SAMVED_SECURE_COOKIE=false
# Optional features:
# SAMVED_NVIDIA_API_KEY=
# PARSE_API_KEY=
# SAMVED_UNSTOP_ENABLED=true
